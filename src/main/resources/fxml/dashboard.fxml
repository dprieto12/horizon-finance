<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">
   <top>
      <HBox styleClass="page-header" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#navigateToAccounts" styleClass="back-button" text="&lt; Back to Accounts" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="32.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" spacing="6.0" translateY="-30.0">
               <children>
                  <Label fx:id="welcomeBackLabel" styleClass="page-title" text="Welcome back, User!" />
                  <Label fx:id="accountBalanceLabel" styleClass="page-subtitle" text="Account Balance: \$xxx.xx" />
               </children>
            </VBox>

            <VBox alignment="CENTER" maxWidth="1100.0" prefHeight="54.0" prefWidth="1100.0" spacing="12.0">
               <children>

                  <!-- Equal-width tiles: each grows with the window instead of carrying its own hardcoded
                       size. The icons are Regions shaped by CSS, so they inherit the theme's text color and
                       need no image files. .action-tile sets contentDisplay TOP, putting each above its label. -->
                  <HBox alignment="CENTER" spacing="16.0">
                     <children>
                        <Button fx:id="transactionsButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#viewTransactions" styleClass="action-tile" text="Transactions" HBox.hgrow="ALWAYS">
                           <graphic>
                              <Region styleClass="tile-icon, icon-money" />
                           </graphic>
                        </Button>
                        <Button fx:id="analyticsButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#viewAnalytics" styleClass="action-tile" text="Analytics" HBox.hgrow="ALWAYS">
                           <graphic>
                              <Region styleClass="tile-icon, icon-chart" />
                           </graphic>
                        </Button>
                        <Button fx:id="accountButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#viewAccount" styleClass="action-tile" text="Settings" HBox.hgrow="ALWAYS">
                           <graphic>
                              <Region styleClass="tile-icon, icon-gear" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
