<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AccountSettingsController">
   <top>
      <HBox styleClass="page-header" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="goBackButton" mnemonicParsing="false" onAction="#goBack" styleClass="back-button" text="&lt;  Dashboard" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" maxWidth="520.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="Your Account" />
                  <Label fx:id="currentBalanceLabel" styleClass="page-subtitle" text="Current Balance: \$xxx.xx" />
               </children>
            </VBox>

            <VBox styleClass="panel">
               <children>
                  <Label styleClass="section-title" text="Edit Account Info" />

                  <GridPane styleClass="form-grid">
                     <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="-Infinity" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>
                     <children>
                        <Label styleClass="field-label" text="Account Name:" />
                        <TextField fx:id="accountNameTextField" maxWidth="Infinity" GridPane.columnIndex="1" />

                        <Label styleClass="field-label" text="User First Name:" GridPane.rowIndex="1" />
                        <TextField fx:id="firstNameTextField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="User Last Name:" GridPane.rowIndex="2" />
                        <TextField fx:id="lastNameTextField" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     </children>
                  </GridPane>

                  <Button fx:id="updateAccountButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#updateAccount" styleClass="accent" text="Update Account" />
                  <Label fx:id="fieldsMissingLabel" styleClass="error-label" text="Some fields are missing." visible="false" />
               </children>
            </VBox>

            <VBox styleClass="panel">
               <children>
                  <Label styleClass="section-title" text="Other" />
                  <Button fx:id="deleteAccountButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#deleteAccount" styleClass="danger" text="Delete Account" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
