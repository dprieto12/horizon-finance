<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AnalyticsDashboardController">
   <content>
      <VBox fx:id="mainVBox" alignment="TOP_CENTER" spacing="10.0">
         <children>
            <HBox alignment="CENTER" prefHeight="51.0" prefWidth="586.0" spacing="60.0">
               <children>
                  <Button maxWidth="105.0" mnemonicParsing="false" onAction="#backToDashboard" prefHeight="25.0" prefWidth="61.0" text="&lt;" />
                  <Label prefHeight="45.0" prefWidth="422.0" styleClass="title" text="Spending Analytics" />
               </children>
            </HBox>
            <Label fx:id="accountInfoLabel" styleClass="subtitle" text="(Account Info)" textFill="#0009ff" />
            <Label styleClass="subtitle" text="Time Period:" />
            <HBox alignment="CENTER" prefHeight="37.0" prefWidth="586.0" spacing="35.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#getThisMonth" text="This Month" />
                  <Button mnemonicParsing="false" onAction="#getLast3Months" text="Last 3 Months" />
                  <Button mnemonicParsing="false" onAction="#getLast6Months" text="Last 6 Months" />
                  <Button mnemonicParsing="false" onAction="#getThisYear" text="This Year" />
                  <Button mnemonicParsing="false" onAction="#getAllTime" text="All Time" />
               </children>
            </HBox>
            <HBox alignment="BOTTOM_CENTER" prefHeight="42.0" prefWidth="586.0" spacing="10.0">
               <children>
                  <DatePicker fx:id="fromDatePicker" promptText="From" />
                  <DatePicker fx:id="toDatePicker" promptText="To" />
                  <Button mnemonicParsing="false" onAction="#customDate" prefHeight="25.0" prefWidth="47.0" text="Go &gt;" />
               </children>
            </HBox>
            <Label fx:id="invalidDateLabel" alignment="CENTER" prefHeight="15.0" prefWidth="127.0" styleClass="content" text="Dates are missing or invalid." textFill="RED" visible="false" />
            <Label fx:id="summaryLabel" styleClass="title" text="Summary - All Time:" />
            <Label fx:id="totalsLabel" alignment="CENTER" prefHeight="17.0" prefWidth="593.0" styleClass="content" text="Total Income: x              Total Expenses:           Net:              Avg/Month:" />
         </children>
      </VBox>
   </content>
</ScrollPane>
