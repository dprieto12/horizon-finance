<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AnalyticsDashboardController">
   <top>
      <VBox styleClass="page-top" BorderPane.alignment="CENTER">
         <children>
            <HBox styleClass="page-header">
               <children>
                  <Button mnemonicParsing="false" onAction="#backToDashboard" styleClass="back-button" text="&lt; Dashboard" />
                  <Label styleClass="page-title" text="Spending Analytics" />
               </children>
            </HBox>

            <!-- Filter controls sit outside mainVBox so they stay put while the charts below scroll. -->
            <VBox styleClass="panel">
               <children>
                  <Label fx:id="accountInfoLabel" styleClass="section-title, accent-fg" text="(Account Info)" />
                  <Label styleClass="field-label" text="Time Period:" />

                  <FlowPane styleClass="toolbar">
                     <children>
                        <Button mnemonicParsing="false" onAction="#getThisMonth" text="This Month" />
                        <Button mnemonicParsing="false" onAction="#getLast3Months" text="Last 3 Months" />
                        <Button mnemonicParsing="false" onAction="#getLast6Months" text="Last 6 Months" />
                        <Button mnemonicParsing="false" onAction="#getThisYear" text="This Year" />
                        <Button mnemonicParsing="false" onAction="#getAllTime" text="All Time" />
                     </children>
                  </FlowPane>

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <DatePicker fx:id="fromDatePicker" promptText="From" />
                        <DatePicker fx:id="toDatePicker" promptText="To" />
                        <Button mnemonicParsing="false" onAction="#customDate" text="Go &gt;" />
                     </children>
                  </HBox>

                  <Label fx:id="invalidDateLabel" styleClass="error-label" text="Dates are missing or invalid." visible="false" />
               </children>
            </VBox>
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fx:id="analyticsScrollPane" fitToWidth="true" styleClass="plain" BorderPane.alignment="CENTER">
         <content>
            <!-- Each region below is an explicit insertion point for AnalyticsDashboardController, so the
                 order of the page is fixed here rather than depending on the order the controller happens to
                 plot in. mainVBox spacing is bound in the controller so gaps grow with the window. -->
            <VBox fx:id="mainVBox">
               <children>
                  <Label fx:id="summaryLabel" styleClass="section-title" text="Summary - All Time:" />
                  <Label fx:id="dataErrorLabel" styleClass="error-label" visible="false" />

                  <HBox fx:id="totalsRow" styleClass="stat-row">
                     <children>
                        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="incomeValueLabel" styleClass="stat-value, amount-income" text="\$0.00" />
                              <Label styleClass="stat-label" text="Total Income" />
                           </children>
                        </VBox>
                        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="expensesValueLabel" styleClass="stat-value, amount-expense" text="\$0.00" />
                              <Label styleClass="stat-label" text="Total Expenses" />
                           </children>
                        </VBox>
                        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="netValueLabel" styleClass="stat-value" text="\$0.00" />
                              <Label styleClass="stat-label" text="Net" />
                           </children>
                        </VBox>
                        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="avgValueLabel" styleClass="stat-value" text="\$0.00" />
                              <Label styleClass="stat-label" text="Net Avg / Month" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox fx:id="barChartBox" styleClass="income-expense-chart" />

                  <!-- Income and expense pies share this row, each taking half the width. -->
                  <HBox fx:id="pieChartRow" alignment="TOP_CENTER" />

                  <!-- Purchases gets its own row: it carries the most categories of the three, so it was
                       unreadably small when all three shared one row at the default window size. -->
                  <VBox fx:id="purchaseChartBox" alignment="TOP_CENTER" />

                  <VBox fx:id="balanceChartBox" />

                  <VBox styleClass="panel">
                     <children>
                        <Label styleClass="section-title" text="Top Transactions" />
                        <VBox fx:id="topTransactionsList" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
